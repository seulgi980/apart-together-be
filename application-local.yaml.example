# 로컬 개발용 설정. 이 파일을 application-local.yaml 로 복사해서 값을 채운다.
#   copy application-local.yaml.example application-local.yaml
# application-local.yaml 은 git에 올라가지 않는다 (.gitignore). 프로젝트 폴더(gradlew 옆)에 둔다.
# 값을 채운 뒤에는 환경 변수 없이 `gradlew bootRun` 만 실행하면 된다.

spring:
  datasource:
    # 로컬 MySQL 비밀번호
    password: ""

app:
  jwt:
    # access token 서명 키. 32글자 이상 아무 문자열 (로컬 전용 값)
    secret: ""
  places:
    # 구글 Places API 키 (서버용)
    google-api-key: ""
