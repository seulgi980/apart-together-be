# EC2의 ~/apart-together/.env 로 복사해서 값을 채운다.  (cp .env.example .env && chmod 600 .env)
# 이 파일(.env.example)에는 실제 값을 적지 않는다. 실제 값이 든 .env 는 git에 올리지 않는다.

# 접속 도메인 (https:// 없이). 예: example.com
DOMAIN=

# 도커 이미지 주소 (전부 소문자). 예: ghcr.io/내깃허브아이디/apart-together-be:latest
BACKEND_IMAGE=
FRONTEND_IMAGE=

# MySQL 비밀번호 2개. 서로 다른 임의의 긴 값으로.  (만들기: openssl rand -base64 24)
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=

# access token 서명 키. 32바이트 이상.  (만들기: openssl rand -base64 48)
JWT_SECRET=

# 구글 Places API 키 (서버용)
GOOGLE_MAPS_API_KEY=
